# Regenerable outputs (videos, CSVs, crops, reports) - stays local
outputs/

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# yolov8n.pt (6 MB, Ultralytics, AGPL-3.0) IS committed, so a fresh clone runs
# without a download. Bigger YOLO weights stay out.

# Heavy ML weights - fetched automatically (HF) or documented in README
*.safetensors
*.bin
*.onnx
*.pth

# models/PaddleOCR/ IS committed: the PaddleOCR source (Apache-2.0, upstream
# https://github.com/PaddlePaddle/PaddleOCR at 2661c7c) that the paddle_anpr plate
# backend imports. Committed as plain files, without its own .git.

# models/person_attr/ IS committed (14 MB): PP-Human PPLCNet weights (Apache-2.0)
# and their ONNX conversion. Exception to the *.onnx rule above:
!models/person_attr/person_attr.onnx

# OS junk
.DS_Store
Thumbs.db

# SegFormer-B2 clothes (MIT) ONNX export: 105 MB, stays local.
# models/MiVOLO/ IS committed: its source (Apache-2.0, upstream
# https://github.com/WildChlamydia/MiVOLO at 37475e3), without its own .git.
# Its weights still come from HuggingFace at runtime.
models/clothes_seg/

# CLIP / SigLIP encoders for open-vocabulary search. The *.onnx rule above
# already covers the weights; these also carry a ~2MB tokenizer.json, and the
# whole directory is reproducible with:
#   python tools/fetch_clip.py --model clip-vit-b16
models/clip_b16/
models/clip_l14/
models/clip/
models/siglip/

# Person-attribute test clips downloaded from YouTube: large, and not ours to
# republish. Keep local. (Moved to samples/short/ in the brother-v3 layout.)
samples/short/person_test.mp4
samples/short/person_test2.mp4

# Long soak-test videos for the dashboard (samples/README.md): 265-320 MB each,
# over GitHub's 100 MB file limit, and person_test_long is built from the
# YouTube clip above. Local only.
samples/long/

# Consented test footage of real people (faces + clothing). Never pushed.
samples/model_test.mp4

# Personal tool state that must not be shared: a Mac Finder archive folder,
# an editor code-graph cache, and per-user Claude Code permissions.
__MACOSX/
.code-review-graph/
.claude/settings.local.json

# Face recognition. The models are ~250 MB and reproducible with
#   python tools/fetch_face_models.py
# Reference photos and test clips are of REAL, CONSENTING people: never pushed.
models/faces/
people/
samples/faces/
