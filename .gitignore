# Regenerable outputs (videos, CSVs, crops, reports) - stays local
outputs/

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# Auto-downloaded on first run (ultralytics fetches it)
yolov8n.pt

# Heavy ML weights - fetched automatically (HF) or documented in README
*.safetensors
*.bin
*.onnx
*.pth

# Third-party PaddleOCR source checkout (runtime dep for paddle_anpr backend;
# clone with: git clone --depth 1 https://github.com/PaddlePaddle/PaddleOCR.git models/PaddleOCR)
models/PaddleOCR/

# Person-attribute model (PP-Human PPLCNet, Apache-2.0) + its ONNX conversion.
# Fetch with: python tools/fetch_person_attr.py
models/person_attr/

# OS junk
.DS_Store
Thumbs.db

# LOCAL-ONLY tests (my machine): stay here, never pushed - the repo keeps
# main system code only. tools/test_reid.py, test_lanes.py and test_stage.py
# are the shared suites and ARE tracked.
#
#   test_congestion.py  congestion level/persistence rules
#   test_incidents.py   incident policy: what fires, when, payload shape
#   test_webhooks.py    delivery: real local receiver, signature, retry ladder
#   test_api.py         the HTTP routes, in-process via TestClient
#
# The last three need the service extras (fastapi/uvicorn/httpx) and skip
# cleanly without them. test_webhooks.py binds 127.0.0.1:9099 while it runs.
tools/test_congestion.py
tools/test_incidents.py
tools/test_webhooks.py
tools/test_api.py

# Dummy webhook consumer: shows what the incident API sends. Local demo tool.
tools/dummy_receiver.py

# SegFormer-B2 clothes (MIT) ONNX export and the MiVOLO source checkout
# (Apache-2.0; imported for its model code, weights come from HuggingFace).
models/clothes_seg/
models/MiVOLO/

# Person-attribute test clips downloaded from YouTube: large, and not ours to
# republish. Keep local.
samples/person_test.mp4
samples/person_test2.mp4
